{
  "name": "awesome-shadcn-ui-manager",
  "version": "1.0.0",
  "description": "一个用于管理和浏览 awesome-shadcn-ui 组件的完整工具集",
  "main": "index.js",
  "scripts": {
    "setup": "node generate-json.js && node component-manager.js all && node generate-advanced-reports.js",
    "stats": "node component-manager.js stats",
